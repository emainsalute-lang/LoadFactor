rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function bounded(v, low, high) { return v is number && v >= low && v <= high; }
    function rating(v) { return v is int && v >= 1 && v <= 10; }
    function shortText(v) { return v is string && v.size() <= 300; }
    function date(v) {
      let parts = v.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
      let maxDay = month == 2 ? (leap ? 29 : 28) : (month in [4,6,9,11] ? 30 : 31);
      return v is string && v.matches('^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$')
        && month >= 1 && month <= 12 && day >= 1 && day <= maxDay;
    }
    function standardTest(v) {
      return v.name in ['10m Sprint','20m Sprint','40-yard Dash','Agility Test'] ? v.unit == 'seconds' && v.direction == 'lower'
        : v.name in ['Vertical Jump','Standing Broad Jump'] ? v.unit == 'cm' && v.direction == 'higher'
        : v.name in ['Push-ups','Pull-ups'] ? v.unit == 'reps' && v.direction == 'higher'
        : v.name in ['Bench Press','Squat','Deadlift'] ? v.unit == 'kg' && v.direction == 'higher'
        : v.name == 'Beep Test' ? v.unit == 'level' && v.direction == 'higher'
        : v.name == 'Bodyweight' ? v.unit == 'kg' && v.direction == 'neutral' : true;
    }
    match /athletes/{uid}/profile/main {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['userId','updatedAt','fullName','photoUrl','sport','position','birthDate','heightCm','weightKg','team','classYear','experience','primaryGoal','secondaryGoals'])
        && request.resource.data.userId == uid
        && shortText(request.resource.data.fullName) && request.resource.data.fullName.size() > 0
        && request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 2000
        && (request.resource.data.photoUrl == '' || request.resource.data.photoUrl.matches('^https://.*'))
        && request.resource.data.sport in ['Basketball','Football/Soccer','American Football','Volleyball','Running','Strength Training','Other']
        && shortText(request.resource.data.position) && shortText(request.resource.data.team)
        && shortText(request.resource.data.primaryGoal) && shortText(request.resource.data.secondaryGoals)
        && (request.resource.data.birthDate == '' || date(request.resource.data.birthDate))
        && (request.resource.data.heightCm == null || bounded(request.resource.data.heightCm,30,300))
        && (request.resource.data.weightKg == null || bounded(request.resource.data.weightKg,1,500))
        && (request.resource.data.classYear == null || (request.resource.data.classYear is int && bounded(request.resource.data.classYear,1900,2200)))
        && request.resource.data.experience in ['Beginner','Intermediate','Advanced']
        && request.resource.data.updatedAt is string;
    }
    match /athletes/{uid}/tests/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['id','userId','name','result','unit','direction','date','notes','protocol','createdAt','updatedAt'])
        && request.resource.data.userId == uid && request.resource.data.id == id
        && shortText(request.resource.data.name) && request.resource.data.name.size() > 0
        && bounded(request.resource.data.result,0.000001,100000)
        && request.resource.data.unit in ['cm','inches','seconds','reps','kg','lbs','level','points']
        && (request.resource.data.unit != 'reps' || request.resource.data.result is int)
        && request.resource.data.direction in ['higher','lower','neutral']
        && standardTest(request.resource.data)
        && date(request.resource.data.date)
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000
        && shortText(request.resource.data.protocol)
        && request.resource.data.createdAt is string && request.resource.data.updatedAt is string
        && (!exists(/databases/$(database)/documents/athletes/$(uid)/tests/$(id)) || request.resource.data.createdAt == resource.data.createdAt);
    }
    match /athletes/{uid}/readiness/{day} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['date','userId','updatedAt','sleepHours','sleepQuality','energy','soreness','stress','motivation'])
        && request.resource.data.userId == uid && request.resource.data.date == day && date(day)
        && bounded(request.resource.data.sleepHours,0,24)
        && rating(request.resource.data.sleepQuality) && rating(request.resource.data.energy)
        && rating(request.resource.data.soreness) && rating(request.resource.data.stress) && rating(request.resource.data.motivation)
        && request.resource.data.updatedAt is string;
    }
    // No coach access is granted in Phase 1. All other paths remain denied.
  }
}
